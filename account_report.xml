<?xml version="1.0"?>
<openerp>
        <data>

<!-- NOTE (Odoo 19 migration): the <report .../> XML shortcut tag was
     removed - report actions are now declared directly as
     ir.actions.report records (see OCA report_xlsx's own demo/report.xml
     for the reference field mapping: string->name, name->report_name,
     file->report_file). -->
<record id="account_vat_ledger_xlsx" model="ir.actions.report">
  <field name="name">Print to XLSX</field>
  <field name="model">account.vat.ledger</field>
  <field name="report_type">xlsx</field>
  <field name="report_name">l10n_ar_account_vat_ledger.account_vat_ledger_xlsx</field>
  <field name="report_file">account_vat_ledger</field>
  <field name="attachment_use">False</field>
</record>

</data>
</openerp>
